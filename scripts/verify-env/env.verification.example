# 検証環境 yegjxkstxhwrknshlaip 用の環境変数（値は .env.verification.local に書く。Gitに入れない）。
# 本番の値は絶対に入れない。preflight.mjs が、検証プロジェクト以外・本番らしい値を拒否する。
NEXT_PUBLIC_SUPABASE_URL=https://yegjxkstxhwrknshlaip.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # 招待メールのリンク先。Supabase の Redirect URLs に <この値>/auth/callback を登録
CRON_SECRET=                                        # 日次失効の手動実行用（任意の長い文字列）
# Stripe は必ずテストモード
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_                        # `stripe listen --forward-to localhost:3000/api/stripe/webhook` が表示する値
# 機能フラグ（検証環境だけ。"1" のときのみ有効）
SCOUT_LEDGER_ENABLED=1
SALON_ACCOUNT_ISSUE_ENABLED=1
MANUAL_BILLING_ENABLED=1
# Bot 対策: Cloudflare Turnstile のテスト用キー
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# メール: 招待メールは Supabase Auth 標準の送信（アプリ側のメール設定は不要）
