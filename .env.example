# ============================================================================
# Beauty Reach — 環境変数サンプル
# 実際の値は .env.local に記載し、Git にはコミットしないこと。
# 秘密鍵はここに書かない（プレースホルダーのみ）。
# ============================================================================

# --- 公開してよい（ブラウザに露出可）: NEXT_PUBLIC_ ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- サーバー専用（絶対にブラウザへ公開しない / NEXT_PUBLIC_ を付けない）---
# Supabase の service role キー（RLSをバイパスするため厳重管理）
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-server-only"

# Anthropic APIキー（AI解説生成はサーバー側からのみ呼び出す）
ANTHROPIC_API_KEY="your-anthropic-api-key-server-only"

# 期限切れpending_diagnoses削除の定期実行(Cron)を認証するための共有シークレット。
# 外部スケジューラ(Vercel Cron等)から /api/cron/cleanup-pending-diagnoses を呼ぶ際、
# Authorization: Bearer <この値> ヘッダで照合する。ランダムな長い文字列を設定すること。
CRON_SECRET="your-random-cron-secret-server-only"

# サイトURL（メール認証・パスワード再設定のリダイレクト先に使用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- 未使用・将来のbot対策(Cloudflare Turnstile等)実装用のプレースホルダー ---
# 設定しない限り lib/security/bot-protection.ts は何もせず素通りする。
# 実装する場合は app/account-recovery/page.tsx にウィジェットを追加し、
# lib/security/bot-protection.ts のTODO部分を実装すること。
# TURNSTILE_SECRET_KEY="your-turnstile-secret-key-server-only"
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
